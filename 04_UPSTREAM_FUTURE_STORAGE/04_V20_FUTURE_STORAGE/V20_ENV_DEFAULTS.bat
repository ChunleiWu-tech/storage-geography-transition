@echo off
rem V20 runtime defaults. Scientific inputs/model are unchanged; these are only
rem deterministic computational budgets for difficult exact LP solves.
call "%~dp0V17_ENV_DEFAULTS.bat"
if errorlevel 1 exit /b 1

if not defined V20_BARRIER_TIME_LIMIT_SECONDS set "V20_BARRIER_TIME_LIMIT_SECONDS=43200"
if not defined V20_FALLBACK_TIME_LIMIT_SECONDS set "V20_FALLBACK_TIME_LIMIT_SECONDS=86400"
if not defined V20_BAR_ITER_LIMIT set "V20_BAR_ITER_LIMIT=100000"
if not defined V20_HARD_LP_TIME_LIMIT_SECONDS set "V20_HARD_LP_TIME_LIMIT_SECONDS=86400"
if not defined V20_HARD_LP_BAR_ITER_LIMIT set "V20_HARD_LP_BAR_ITER_LIMIT=100000"
if not defined V20_SL10_BARRIER_TIME_LIMIT_SECONDS set "V20_SL10_BARRIER_TIME_LIMIT_SECONDS=43200"

set "V17_ECONOMIC_BARRIER_TIME_LIMIT_SECONDS=%V20_BARRIER_TIME_LIMIT_SECONDS%"
set "V17_ECONOMIC_FALLBACK_TIME_LIMIT_SECONDS=%V20_FALLBACK_TIME_LIMIT_SECONDS%"
set "V17_ECONOMIC_BAR_ITER_LIMIT=%V20_BAR_ITER_LIMIT%"
set "V17T1_HARD_LP_TIME_LIMIT_SECONDS=%V20_HARD_LP_TIME_LIMIT_SECONDS%"
set "V17T1_HARD_LP_BAR_ITER_LIMIT=%V20_HARD_LP_BAR_ITER_LIMIT%"
set "V17T2_SL10_BARRIER_TIME_LIMIT_SECONDS=%V20_SL10_BARRIER_TIME_LIMIT_SECONDS%"
if not defined V17_SOLVER_THREADS set "V17_SOLVER_THREADS=10"

exit /b 0
