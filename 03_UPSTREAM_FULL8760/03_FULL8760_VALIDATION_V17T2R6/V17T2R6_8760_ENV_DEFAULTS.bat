@echo off
rem User-overridable runtime defaults. Set variables before calling a launcher to override them.
if not defined V17T2R6_PYTHON set "V17T2R6_PYTHON=py -3.11"
if not defined V17T2R6_JULIA set "V17T2R6_JULIA=julia"
if not defined V17_SOLVER_THREADS set "V17_SOLVER_THREADS=10"
if not defined V17T2R6_MAX_PARALLEL set "V17T2R6_MAX_PARALLEL=2"
if not defined V17T2R6_8760_PRIMARY_TIME_LIMIT_SECONDS set "V17T2R6_8760_PRIMARY_TIME_LIMIT_SECONDS=43200"
if not defined V17T2R6_8760_FALLBACK_TIME_LIMIT_SECONDS set "V17T2R6_8760_FALLBACK_TIME_LIMIT_SECONDS=86400"
if not defined V17T2R6_8760_PRIMARY_BAR_ITER_LIMIT set "V17T2R6_8760_PRIMARY_BAR_ITER_LIMIT=100000"
if not defined V17T2R6_8760_FALLBACK_BAR_ITER_LIMIT set "V17T2R6_8760_FALLBACK_BAR_ITER_LIMIT=100000"
if not defined V17T2R6_8760_CROSSOVER_BASIS set "V17T2R6_8760_CROSSOVER_BASIS=1"
set "PYTHONDONTWRITEBYTECODE=1"
set "MPLBACKEND=Agg"
