@echo off
rem V18R1 user-overridable runtime defaults. The V17-prefixed solver variables are
rem retained deliberately because the frozen V17T2R5 Julia core reads those names.
if not defined V18R1_PYTHON set "V18R1_PYTHON=py -3.11"
if not defined V18R1_JULIA set "V18R1_JULIA=julia"
if not defined V17_SOLVER_THREADS set "V17_SOLVER_THREADS=10"
if not defined V17T2R5_PRIMARY_TIME_LIMIT_SECONDS set "V17T2R5_PRIMARY_TIME_LIMIT_SECONDS=7200"
if not defined V17T2R5_FALLBACK_TIME_LIMIT_SECONDS set "V17T2R5_FALLBACK_TIME_LIMIT_SECONDS=14400"
if not defined V17T2R5_CROSSOVER_BASIS set "V17T2R5_CROSSOVER_BASIS=1"
if not defined V17_ECONOMIC_BARRIER_TIME_LIMIT_SECONDS set "V17_ECONOMIC_BARRIER_TIME_LIMIT_SECONDS=43200"
if not defined V17_ECONOMIC_FALLBACK_TIME_LIMIT_SECONDS set "V17_ECONOMIC_FALLBACK_TIME_LIMIT_SECONDS=86400"
if not defined V17_ECONOMIC_BAR_ITER_LIMIT set "V17_ECONOMIC_BAR_ITER_LIMIT=100000"
if not defined V17T1_HARD_LP_TIME_LIMIT_SECONDS set "V17T1_HARD_LP_TIME_LIMIT_SECONDS=86400"
if not defined V17T1_HARD_LP_BAR_ITER_LIMIT set "V17T1_HARD_LP_BAR_ITER_LIMIT=100000"
set "PYTHONDONTWRITEBYTECODE=1"
set "MPLBACKEND=Agg"
