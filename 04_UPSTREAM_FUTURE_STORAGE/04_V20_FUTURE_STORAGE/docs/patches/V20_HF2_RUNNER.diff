+# V20-HF2 runtime contract for Layer B/C.
+# The central multi-period pathway keeps the validated V17 representative-day
+# chronology unchanged so that the only structural intervention is the future
+# technology-duration portfolio. Linked-month chronology remains a separate
+# diagnostic/sensitivity and is not silently substituted into the headline run.
+V20_LAYER_B_CHRONOLOGY_MODE = "intraday_cyclic"
+V20_LAYER_B_PORTFOLIO_MODE = "evidence_bounded"
+V20_RUNTIME_CONTRACT = ROOT / "data" / "processed" / "v20_layer_b_runtime_contract.csv"
+
+def runtime_contract_for(scenario: str) -> tuple[str, str]:
+    if not V20_RUNTIME_CONTRACT.is_file():
+        raise SystemExit(f"V20 runtime contract missing: {V20_RUNTIME_CONTRACT}")
+    d = pd.read_csv(V20_RUNTIME_CONTRACT)
+    r = d.loc[d["scenario"].astype(str).eq(str(scenario))]
+    if len(r) != 1:
+        raise SystemExit(f"Expected exactly one V20 runtime-contract row for {scenario}; found {len(r)}")
+    chrono = str(r.iloc[0]["storage_chronology_mode"])
+    portfolio = str(r.iloc[0]["v18_storage_portfolio_mode"])
+    if chrono != V20_LAYER_B_CHRONOLOGY_MODE or portfolio != V20_LAYER_B_PORTFOLIO_MODE:
+        raise SystemExit(f"V20 runtime contract drift for {scenario}: chronology={chrono}, portfolio={portfolio}")
+    return chrono, portfolio
+
 
 def _true(value: object) -> bool:
     return str(value).strip().lower() in {"true", "1", "yes"}
